# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== 环境变量与密钥 =====
.env

# ===== 登录会话 Cookie（严禁提交）=====
data/raw/cookies.json
cookies.json

# ===== 数据 =====
# 仓库为私有，原图 / OCR 文本 / 中间产物一并入库（约 65 MB），
# 克隆下来即可跳过爬取与 OCR 直接复现。
# 注意：这些内容含未脱敏的门户原文，**变更仓库可见性前必须先脱敏**。

# ===== 数据库（例外：只提交构建好的最终产物）=====
# 仓库已转为私有，因此把构建好的 SQLite 库随代码一起提交，
# 克隆下来即可直接启动，无需先跑 OCR 与建库流程。
# 注意：库内含真实姓名（选调生去向），**变更仓库可见性前必须先脱敏**。
data/db/*
!data/db/.gitkeep
!data/db/selects.sqlite
!data/db/_db_summary.json
# WAL 日志与共享内存是运行期伴生文件，必须排除
*.sqlite-wal
*.sqlite-shm

# ===== 手工整理表格 =====
# xlsx 原件随仓库保存（私有库），与 data/manual/imported/*.json 互为校验。
# 注意：原件含真实姓名，**变更仓库可见性前必须先脱敏**。

# ===== 日志 =====
# 运行日志随仓库保存，便于排障（含已失效的临时隧道地址，不构成泄露）。
# 仅排除运行期标记文件 logs/*.stop。
logs/*.stop

# ===== Notebook 检查点 =====
.ipynb_checkpoints/

# ===== IDE / 系统 =====
.vscode/
.idea/
.DS_Store
Thumbs.db
# Office 打开文档时生成的锁文件（~$xxx.xlsx）
~$*

# ===== AI 编码工具产物 =====
# .agents/ 是第三方技能包（约 3.5 MB），随仓库保存以便在新机器上直接可用。
# .claude/ 为本地会话缓存，仍不入库。
.claude/

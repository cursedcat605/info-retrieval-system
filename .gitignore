# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== 环境变量与密钥 =====
.env

# ===== 登录会话 Cookie（严禁提交）=====
data/raw/cookies.json
cookies.json

# ===== 数据（原始数据不入库）=====
# 爬取的原图、OCR 文本与中间产物一律不提交：体积大、且含未脱敏的门户原文。
data/raw/images/
data/raw/metadata/
data/interim/
data/processed/

# ===== 数据库（例外：只提交构建好的最终产物）=====
# 仓库已转为私有，因此把构建好的 SQLite 库随代码一起提交，
# 克隆下来即可直接启动，无需先跑 OCR 与建库流程。
# 注意：库内含真实姓名（选调生去向），**变更仓库可见性前必须先脱敏**。
data/db/*
!data/db/.gitkeep
!data/db/selects.sqlite
!data/db/_db_summary.json
# WAL 日志与共享内存是运行期伴生文件，必须排除
*.sqlite-wal
*.sqlite-shm

# ===== 模型权重（体积大）=====
models/*
!models/.gitkeep

# ===== 日志 =====
logs/*.log
logs/*.log.*
logs/*.txt
logs/*.jsonl
logs/*.stop
!logs/.gitkeep

# ===== Notebook 检查点 =====
.ipynb_checkpoints/

# ===== IDE / 系统 =====
.vscode/
.idea/
.DS_Store
Thumbs.db

# ===== AI 编码工具产物（与系统运行无关）=====
# .agents/ 是第三方技能包（约 3.6 MB），skills-lock.json 是工具自己的锁文件。
.agents/
.claude/
skills-lock.json

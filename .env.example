# ===== 环境变量模板 =====
# 复制为 .env 后填写真实值，切勿将 .env 提交到版本库

# --- 学校信息门户账号 ---
PORTAL_BASE_URL=https://portal.example.edu.cn
PORTAL_USERNAME=
PORTAL_PASSWORD=
# 门户登录后的 Cookie（如不便脚本登录，可手动获取后填入）
PORTAL_COOKIE=

# --- 目标栏目 / 关键词 ---
PORTAL_TARGET_KEYWORD=选调经验分享

# --- 数据库 ---
# SQLite 相对路径
DATABASE_URL=sqlite:///./data/db/selects.db
# MySQL 示例：
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/selects

# --- OCR ---
OCR_LANG=ch
OCR_USE_GPU=false

# --- 日志 ---
LOG_LEVEL=INFO
